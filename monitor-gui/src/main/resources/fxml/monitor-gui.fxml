<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="MonitorController"
            prefWidth="700" prefHeight="400">
    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idCol" text="Invoice ID"/>
                <TableColumn fx:id="clientCol" text="Klijent"/>
                <TableColumn fx:id="totalCol" text="Total BAM"/>
                <TableColumn fx:id="statusCol" text="Status"/>
                <TableColumn fx:id="timeCol" text="Vrijeme"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="statusLabel" text="Cekam notifikacije..." BorderPane.alignment="CENTER_LEFT">
            <BorderPane.margin>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
